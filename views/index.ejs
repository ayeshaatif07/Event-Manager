<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <!-- Viewport for responsive layout on different devices -->
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Event Manager Home</title>

  <!-- Bootstrap CSS for responsive design and styling -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <style>
    /*page background with gradient and background image */
    body {
      background: linear-gradient(to right, #cbe2f3, #7bbaee);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /*card styling with blur and animation */
    .card {
      background-color: #ffffffdd; /* semi-transparent white background */
      backdrop-filter: blur(8px);  /* adds background blur */
      animation: fadeInUp 1s ease-out;
    }

    /*animation for fade-in effect */
    @keyframes fadeInUp {
      from {
        transform: translateY(80px);
        opacity: 0;
      }
      to {
        transform: translateY(0);
        opacity: 1;
      }
    }
  </style>
</head>
<body>

  <!--main Card with title and navigation buttons -->
  <div class="card shadow-lg rounded-4 p-5 text-center" style="max-width: 500px; width: 100%;">
    <h1 class="text-primary fw-bold mb-4">🎫 Event Manager</h1>

    <!--instructional text -->
    <p class="fs-5 text-muted mb-4">Please choose your view:</p>

    <!--navigation buttons to organiser and attendee pages -->
    <div class="d-grid gap-3">
      <a href="/organiser" class="btn btn-primary btn-lg">👩‍💼 Organiser Page</a>
      <a href="/attendee" class="btn btn-success btn-lg">🧑‍🤝‍🧑 Attendee Page</a>
    </div>
  </div>

  <!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <!-- Bootstrap JS for interactive components -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>