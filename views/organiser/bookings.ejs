<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>All Bookings</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!--include Bootstrap CSS and Bootstrap Icons for styling -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

  <!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <style>
    /*set background with a gradient and image */
    body {
      background: linear-gradient(to right, #cbe2f3, #7bbaee);
      min-height: 100vh;
      padding: 2rem;
    }

    /*style the main container holding the table */
    .table-container {
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
      padding: 2rem;
    }

    /*style for button hover effects */
    .btn-hover:hover {
      filter: brightness(1.05);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease;
    }
  </style>
</head>
<body>

  <!--main Bootstrap container for all content -->
  <div class="container table-container">

    <!--header section with title and back button -->
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="text-primary"><i class="bi bi-journal-text"></i> All Event Bookings</h2>
      <!--back to organiser dashboard -->
      <a href="/organiser" class="btn btn-outline-secondary btn-hover">
        <i class="bi bi-arrow-left"></i> Back to Organiser Home
      </a>
    </div>

    <!--table displaying all bookings -->
    <div class="table-responsive">
      <table class="table table-bordered table-striped align-middle">
        <thead class="table-dark">
          <tr>
            <th>Event Title</th>
            <th>Attendee Name</th>
            <th>Full Price Quantity</th>
            <th>Concession Quantity</th>
            <th>Booking Date</th>
          </tr>
        </thead>
        <tbody>
          <!--loop through bookings data and show each row -->
          <% bookings.forEach(booking => { %>
            <tr>
              <td><%= booking.event_title %></td>
              <td><%= booking.attendee_name %></td>
              <td><%= booking.full_price_qty_booked %></td>
              <td><%= booking.concession_qty_booked %></td>
              <td><%= booking.created_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

<!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <!--include Bootstrap JS for components like dropdowns, toasts, etc. -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>