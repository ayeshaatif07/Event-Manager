<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Event</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS and Icons for responsive design and icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <style>
    /* Background styling with a gradient and background image */
    body {
      background: linear-gradient(to right, #cbe2f3, #7bbaee);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    /* Styling for the form container */
    .form-container {
      background-color: #fff;
      padding: 2.5rem;
      border-radius: 15px;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1);
      max-width: 650px;
      width: 100%;
    }

    /* Hover effect for buttons */
    .btn-hover:hover {
      filter: brightness(1.1);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease-in-out;
    }

    /* Title styling */
    .form-title {
      font-weight: bold;
      color: #6a1b9a;
    }
  </style>
</head>
<body>

  <!--form wrapper for editing an event -->
  <div class="form-container">
    <!--form title with icon and event name -->
    <h2 class="text-center mb-4 form-title"><i class="bi bi-pencil-square"></i> Edit Event - <%= event.title %></h2>

    <!-- form to submit event updates -->
    <form action="/organiser/event/<%= event.id %>/update" method="POST">

      <!--event title input -->
      <div class="mb-3">
        <label for="title" class="form-label">Event Title:</label>
        <input type="text" id="title" name="title" class="form-control" value="<%= event.title %>" required>
      </div>

      <!--event description input -->
      <div class="mb-3">
        <label for="description" class="form-label">Event Description:</label>
        <textarea id="description" name="description" class="form-control" rows="4"><%= event.description %></textarea>
      </div>

      <!-- event date input -->
      <div class="mb-3">
        <label for="date" class="form-label">Event Date:</label>
        <input type="date" id="date" name="date" class="form-control" value="<%= event.date %>" required>
      </div>

      <!--row for full price ticket quantity and price -->
      <div class="row mb-3">
        <div class="col">
          <label for="full_price_qty" class="form-label">Full Price Quantity:</label>
          <input type="number" id="full_price_qty" name="full_price_qty" class="form-control" min="0" value="<%= event.full_price_qty %>" required>
        </div>
        <div class="col">
          <label for="full_price" class="form-label">Full Price ($):</label>
          <input type="number" id="full_price" name="full_price" class="form-control" step="0.01" min="0" value="<%= event.full_price %>" required>
        </div>
      </div>

      <!-- row for concession ticket quantity and price -->
      <div class="row mb-4">
        <div class="col">
          <label for="concession_qty" class="form-label">Concession Quantity:</label>
          <input type="number" id="concession_qty" name="concession_qty" class="form-control" min="0" value="<%= event.concession_qty %>" required>
        </div>
        <div class="col">
          <label for="concession_price" class="form-label">Concession Price ($):</label>
          <input type="number" id="concession_price" name="concession_price" class="form-control" step="0.01" min="0" value="<%= event.concession_price %>" required>
        </div>
      </div>

      <!--buttons to go back or submit changes -->
      <div class="d-flex justify-content-between">
        <a href="/organiser" class="btn btn-outline-secondary btn-hover">
          <i class="bi bi-arrow-left"></i> Back
        </a>
        <button type="submit" class="btn btn-primary btn-hover">
          <i class="bi bi-save"></i> Save Changes
        </button>
      </div>
    </form>
  </div>

  <!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <!-- Bootstrap JavaScript Bundle -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>