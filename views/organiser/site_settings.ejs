<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Site Settings</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!-- Bootstrap CSS and Icons for styling and layout -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <style>
    /*page background with gradient and image */
    body {
      background: linear-gradient(to right, #cbe2f3, #7bbaee);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /*styling for the form container */
    .form-container {
      width: 100%;
      max-width: 600px;
      background: #fff;
      padding: 2rem;
      border-radius: 10px;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
    }

    /*hover effect for buttons */
    .btn-hover:hover {
      filter: brightness(1.1);
      box-shadow: 0 3px 6px rgba(0, 0, 0, 0.15);
      transition: 0.5s ease-in-out;
    }
  </style>
</head>
<body>

  <!--settings form container -->
  <div class="form-container">
    <!-- Form header -->
    <h2 class="text-center text-primary mb-4"><i class="bi bi-gear-fill"></i> Site Settings</h2>

    <!-- Form to update site name and description -->
    <form action="/organiser/settings" method="POST">
      <!-- Site Name input field -->
      <div class="mb-3">
        <label for="site_name" class="form-label">Site Name:</label>
        <!-- Prefilled with current setting value if available -->
        <input type="text" id="site_name" name="site_name" class="form-control" value="<%= settings ? settings.site_name : '' %>" required>
      </div>

      <!-- Site Description text area -->
      <div class="mb-4">
        <label for="site_description" class="form-label">Site Description:</label>
        <!-- Prefilled with current setting value if available -->
        <textarea id="site_description" name="site_description" class="form-control" rows="4" required><%= settings ? settings.site_description : '' %></textarea>
      </div>

      <!-- Navigation buttons -->
      <div class="d-flex justify-content-between">
        <!-- Back to Organiser Home -->
        <a href="/organiser" class="btn btn-outline-secondary btn-hover"><i class="bi bi-arrow-left"></i> Back</a>
        <!-- Submit button to save settings -->
        <button type="submit" class="btn btn-success btn-hover"><i class="bi bi-save"></i> Save Settings</button>
      </div>
    </form>
  </div>

<!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <!-- Bootstrap JS Bundle for responsive components -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>