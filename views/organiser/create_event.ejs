<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Create New Event</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <!--bootstrap CSS & Icons for styling and icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

<!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <style>
    /*background styling with gradient and image */
    body {
      background: linear-gradient(to right, #cbe2f3, #7bbaee);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
    }

    /*container for the form */
    .form-container {
      background-color: #ffffff;
      padding: 1rem;
      border-radius: 15px;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1);
      max-width: 600px;
      width: 100%;
    }

    /*hover effect on buttons */
    .btn-hover:hover {
      filter: brightness(1.1);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
      transition: all 0.3s ease-in-out;
    }

    /* title styling */
    .form-title {
      font-weight: bold;
      color: #00796b;
    }
  </style>
</head>
<body>

  <!--main wrapper for the form -->
  <div class="form-container">
    <!--Form heading with calendar icon -->
    <h2 class="text-center mb-4 form-title"><i class="bi bi-calendar-plus-fill"></i> Create New Event</h2>

    <!-- event creation form -->
    <form action="/organiser/event/new" method="POST">

      <!--input for event title -->
      <div class="mb-3">
        <label for="title" class="form-label">Event Title:</label>
        <input type="text" id="title" name="title" class="form-control" required>
      </div>

      <!-- this is the ttextarea for event description -->
      <div class="mb-3">
        <label for="description" class="form-label">Event Description:</label>
        <textarea id="description" name="description" class="form-control" rows="3"></textarea>
      </div>

      <!--date input for selecting event date -->
      <div class="mb-3">
        <label for="date" class="form-label">Event Date:</label>
        <input type="date" id="date" name="date" class="form-control" required>
      </div>

      <!--full price ticket quantity -->
      <div class="mb-3">
        <label for="full_price_qty" class="form-label">Full Price Ticket Quantity:</label>
        <input type="number" id="full_price_qty" name="full_price_qty" class="form-control" min="0" required>
      </div>

      <!--ffull price ticket cost -->
      <div class="mb-3">
        <label for="full_price" class="form-label">Full Price Ticket Price ($):</label>
        <input type="number" id="full_price" name="full_price" class="form-control" step="0.01" min="0" required>
      </div>

      <!--concession ticket quantity -->
      <div class="mb-3">
        <label for="concession_qty" class="form-label">Concession Ticket Quantity:</label>
        <input type="number" id="concession_qty" name="concession_qty" class="form-control" min="0" required>
      </div>

      <!--concession ticket cost -->
      <div class="mb-4">
        <label for="concession_price" class="form-label">Concession Ticket Price ($):</label>
        <input type="number" id="concession_price" name="concession_price" class="form-control" step="0.01" min="0" required>
      </div>

      <!-- the Submit and Back buttons -->
      <div class="d-flex justify-content-between">
        <a href="/organiser" class="btn btn-outline-secondary btn-hover">
          <i class="bi bi-arrow-left-circle"></i> Back
        </a>
        <button type="submit" class="btn btn-primary btn-hover">
          <i class="bi bi-plus-circle-fill"></i> Create Event
        </button>
      </div>
    </form>
  </div>

<!-----------------------------------------------------------------------MY OWN CODE ------------------------------------------------------------------------------>

  <!--include Bootstrap JS bundle for components -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>